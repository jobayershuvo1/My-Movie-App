# CineVault optional environment variables
# SQLite is initialized automatically at data/cinevault.db.

# Movie autofill keys (set at least one)
TMDB_API_KEY="your-tmdb-v3-api-key-here"
OMDB_API_KEY="your-omdb-api-key-here"

# Optional legacy Gemini autofill
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional deployed URL for callbacks and self-referential links
APP_URL="https://your-deployed-domain.com"

# Optional email promoted to super_admin when registering
VITE_SUPER_ADMIN_EMAIL="your-admin-email@example.com"

# Optional server-side seeded super-admin credentials.
# Store the password only in .env.local or deployment secrets; never commit it.
LOCAL_ADMIN_EMAIL="admin@example.com"
LOCAL_ADMIN_PASSWORD="use-a-strong-secret"

# Protects optional manual licensed-movie imports in production.
INGESTION_SECRET="replace-with-a-long-random-secret"
