{
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/import-movies?limit=3",
      "schedule": "15 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/movies/autofill",
      "destination": "/api/movies/autofill.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|.*\\.png|.*\\.jpg|.*\\.svg|.*\\.css|.*\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
